+    if (this instanceof InstanceObjectType inst) {
+      ObjectType proto = inst.getImplicitPrototype();
+      if ((proto != null && proto.hasOwnDeclaredProperty(propertyName))
+          || inst.hasOwnDeclaredProperty(propertyName)) {
+        return false;
+      }
+      Property newProp = new Property(propertyName, type, inferred, propertyNode);
+      inst.ensurePropertyMap().putProperty(propertyName, newProp);
+      return true;
+    }
+    if (this instanceof PrototypeObjectType proto
+        && !(this instanceof FunctionType)
+        && !(this instanceof RecordType)) {
+      if (proto.hasOwnDeclaredProperty(propertyName)) {
+        return false;
+      }
+      Property newProp = new Property(propertyName, type, inferred, propertyNode);
+      proto.ensurePropertyMap().putProperty(propertyName, newProp);
+      return true;
+    }
     return defineProperty(new Property.StringKey(propertyName), type, inferred, propertyNode);
   }
 
