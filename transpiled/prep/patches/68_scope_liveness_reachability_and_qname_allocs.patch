+  /**
+   * Looks up a qualified name string directly without allocating {@link QualifiedName} wrappers or
+   * intermediate joined strings.
+   */
+  default @Nullable JSType lookupQualifiedName(String qname) {
+    StaticTypedSlot slot = getSlot(qname);
+    if (slot != null && !slot.isTypeInferred()) {
+      return slot.getType();
+    }
+    int lastDot = qname.lastIndexOf('.');
+    if (lastDot >= 0) {
+      JSType type = lookupQualifiedName(qname.substring(0, lastDot));
+      if (type != null && !type.isUnknownType()) {
+        return type.findPropertyType(qname.substring(lastDot + 1));
+      }
+    }
+    return null;
+  }
