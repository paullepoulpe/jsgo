+    public boolean setOption(String name, String value) throws CmdLineException {
+      switch (name) {
+        case "--js":
+          this.js.add(value);
+          return true;
+        case "--compilation_level":
+          this.compilationLevel = value;
+          return true;
+        case "--warning_level":
+          try {
+            this.warningLevel = WarningLevel.valueOf(value);
+          } catch (IllegalArgumentException e) {
+            throw new CmdLineException(parser, e);
+          }
+          return true;
+        case "--language_in":
+          this.languageIn = value;
+          return true;
+        case "--language_out":
+          this.languageOut = value;
+          return true;
+        case "--js_output_file":
+          this.jsOutputFile = value;
+          return true;
+        default:
+          return false;
+      }
+    }
+
     Flags() {
       parser = new CmdLineParser(this);
