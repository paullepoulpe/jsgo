{
  "name": "downlevel-simple",
  "order": 4,
  "title": "Down-levelling, SIMPLE",
  "description": "ES2015+ library code down-levelled to ES5: Angular 16.2.12 `fesm2022/core.mjs` (ES2022 module; 16.x is the last major whose core imports nothing but rxjs), the rxjs 7.8.2 ES2015 module tree (`dist/esm`), tslib 2.8.1, and core-js 3.50.0 (CommonJS modules, entry `stable/index.js`). Inputs are passed through a `node_modules/` layout of symlinks with their package.json files; NODE module resolution, CommonJS rewriting, `--dependency_mode=PRUNE` from the two entry points (2,094 candidate files).",
  "mode": "SIMPLE, `--language_out=ECMASCRIPT5`",
  "flags": [
    "--compilation_level=SIMPLE",
    "--language_out=ECMASCRIPT5",
    "--module_resolution=NODE",
    "--process_common_js_modules",
    "--package_json_entry_names=es2015,module,main",
    "--dependency_mode=PRUNE",
    "--entry_point=node_modules/@angular/core/fesm2022/core.mjs",
    "--entry_point=node_modules/core-js/stable/index.js"
  ],
  "inputs": [
    {
      "file": "node_modules/@angular/core/package.json"
    },
    {
      "file": "node_modules/rxjs/package.json"
    },
    {
      "file": "node_modules/rxjs/operators/package.json"
    },
    {
      "file": "node_modules/tslib/package.json"
    },
    {
      "file": "node_modules/core-js/package.json"
    },
    {
      "glob": "node_modules/@angular/core/fesm2022/core.mjs"
    },
    {
      "glob": "node_modules/rxjs/dist/esm/**/*.js"
    },
    {
      "file": "node_modules/tslib/tslib.es6.js"
    },
    {
      "glob": "node_modules/core-js/stable/**/*.js"
    },
    {
      "glob": "node_modules/core-js/es/**/*.js"
    },
    {
      "glob": "node_modules/core-js/web/**/*.js"
    },
    {
      "glob": "node_modules/core-js/modules/**/*.js"
    },
    {
      "glob": "node_modules/core-js/internals/**/*.js"
    }
  ],
  "output_args": [
    "--js_output_file=out.js"
  ],
  "compare": [
    "out.js"
  ]
}
