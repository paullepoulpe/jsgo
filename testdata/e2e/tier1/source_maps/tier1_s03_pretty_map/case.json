{
  "id": "tier1_s03_pretty_map",
  "tier": 1,
  "feature": "source_maps",
  "name": "Source map with PRETTY_PRINT",
  "description": "Verifies source map generation when combined with PRETTY_PRINT formatting",
  "args": [
    "--create_source_map",
    "pretty.js.map",
    "--js_output_file",
    "pretty.js",
    "--formatting",
    "PRETTY_PRINT",
    "--js",
    "in.js"
  ],
  "stdin": "",
  "files": {
    "in.js": "function compute(x, y) {\n  var temp = x + 1;\n  return temp * y;\n}\n"
  },
  "expected": {
    "exit_code": 0,
    "stdout": "",
    "stderr": "",
    "output_files": {
      "pretty.js.map": "{\n\"version\":3,\n\"file\":\"pretty.js\",\n\"lineCount\":4,\n\"mappings\":\"AAAAA,QAASA,QAAO,CAACC,CAAD,EAAIC,CAAJ,CAAO;AAErB,UADWD,CACX,GADe,CACf,IAAcC,CAAd;AAFqB;;\",\n\"sources\":[\"in.js\"],\n\"names\":[\"compute\",\"x\",\"y\"]\n}\n",
      "pretty.js": "function compute(a, b) {\n  return (a + 1) * b;\n}\n;\n"
    }
  }
}