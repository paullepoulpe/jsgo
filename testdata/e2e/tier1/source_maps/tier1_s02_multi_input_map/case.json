{
  "id": "tier1_s02_multi_input_map",
  "tier": 1,
  "feature": "source_maps",
  "name": "Source map across multiple inputs",
  "description": "Verifies source map generation with multiple input files properly recording file sources",
  "args": [
    "--create_source_map",
    "multi.js.map",
    "--js_output_file",
    "multi.js",
    "--js",
    "f1.js",
    "--js",
    "f2.js"
  ],
  "stdin": "",
  "files": {
    "f1.js": "var alpha = 10;",
    "f2.js": "var beta = alpha * 2;"
  },
  "expected": {
    "exit_code": 0,
    "stdout": "",
    "stderr": "",
    "output_files": {
      "multi.js": "var alpha=10;var beta=alpha*2;\n",
      "multi.js.map": "{\n\"version\":3,\n\"file\":\"multi.js\",\n\"lineCount\":1,\n\"mappings\":\"AAAA,IAAIA,MAAQ,E,CCAZ,IAAIC,KAAOD,KAAPC,CAAe;\",\n\"sources\":[\"f1.js\",\"f2.js\"],\n\"names\":[\"alpha\",\"beta\"]\n}\n"
    }
  }
}