{
  "id": "tier1_s04_wrapped_map",
  "tier": 1,
  "feature": "source_maps",
  "name": "Source map with output wrapper",
  "description": "Verifies source map mapping coordinates account for wrapper line offsets",
  "args": [
    "--create_source_map",
    "wrap.js.map",
    "--js_output_file",
    "wrap.js",
    "--output_wrapper",
    "//header\n(function(){\n%output%\n})();",
    "--js",
    "in.js"
  ],
  "stdin": "",
  "files": {
    "in.js": "var wrappedVal = 42;"
  },
  "expected": {
    "exit_code": 0,
    "stdout": "",
    "stderr": "",
    "output_files": {
      "wrap.js": "//header\n(function(){\nvar wrappedVal=42;\n})();\n",
      "wrap.js.map": "{\n\"version\":3,\n\"file\":\"wrap.js\",\n\"lineCount\":3,\n\"mappings\":\"A;;AAAA,IAAIA,WAAa;\",\n\"sources\":[\"in.js\"],\n\"names\":[\"wrappedVal\"]\n}\n"
    }
  }
}