   public final boolean equals(@Nullable Object other) {
     if (this == other) {
       return true;
+    }
+    // Cached, non-generic plain objects cannot equal these scalar or unknown types.
+    // Keep subclasses and uncached/template-bearing objects on the full checker path.
+    if (getClass() == PrototypeObjectType.class
+        && (other instanceof NullType || other instanceof VoidType || other instanceof UnknownType)
+        && ((ObjectType) this).hasCachedValues()
+        && templateTypeMap.isEmpty()) {
+      return false;
     }
     return (other instanceof JSType jSType)
         && new EqualityChecker().setEqMethod(EqMethod.IDENTITY).check(this, jSType);
